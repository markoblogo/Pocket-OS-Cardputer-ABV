#!/bin/zsh
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../../../.." && pwd)"
RESOURCES="$HERE/../Resources"
SUPPORT="$HOME/Library/Application Support/ABVx Companion"
mkdir -p "$SUPPORT/companion_ui"
SOURCE="$RESOURCES"
if [[ -f "$ROOT/tools/abvx_companion_app.py" ]]; then
  SOURCE="$ROOT/tools"
  export ABVX_PROJECT_ROOT="${ABVX_PROJECT_ROOT:-$ROOT}"
fi
for file in "$SOURCE"/*.py; do cp "$file" "$SUPPORT/"; done
cp "$SOURCE/companion_ui/index.html" "$SUPPORT/companion_ui/index.html"
PYTHON="${ABVX_COMPANION_PYTHON:-}"
if [[ -z "$PYTHON" && -x "$SUPPORT/.venv/bin/python3" ]]; then PYTHON="$SUPPORT/.venv/bin/python3"; fi
if [[ -z "$PYTHON" ]]; then PYTHON="$(command -v python3)"; fi
exec "$PYTHON" "$SUPPORT/abvx_companion_app.py"
